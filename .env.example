# Lido automaticamente pelo `docker compose` a partir da raiz do repo.
# Copie para `.env` só se precisar sobrescrever algum default — os valores
# abaixo já funcionam para uso local sem edição nenhuma.

# Credenciais do Postgres usadas pelo serviço `db` (ver docker-compose.yml).
POSTGRES_USER=amactive
POSTGRES_PASSWORD=amactive
POSTGRES_DB=amactive

# Porta do host mapeada para o Postgres do container (5433, não 5432, para
# não colidir com um Postgres local já rodando na porta padrão). Só importa
# se você for conectar no banco de fora do Docker (ex.: um client SQL) — a
# API sempre fala com o `db` pela rede interna do compose, nunca por aqui.
DB_HOST_PORT=5433

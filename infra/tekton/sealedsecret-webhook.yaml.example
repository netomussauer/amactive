# ATENÇÃO: este arquivo é apenas um TEMPLATE. Não commitar valores reais.
#
# Segredo HMAC compartilhado com o Gitea para validar a assinatura
# X-Hub-Signature-256 dos eventos de push (ver interceptor "github" em
# infra/tekton/triggers.yaml).
#
# Como gerar o SealedSecret correto (após ter acesso real ao cluster):
#
#   1. Gerar um token aleatório forte:
#      WEBHOOK_TOKEN="$(openssl rand -hex 32)"
#      echo "$WEBHOOK_TOKEN"   # anotar — será usado no passo 4 (Gitea)
#
#   2. Criar o Secret em manifest local (NÃO commitar):
#      cat <<EOF > /tmp/amactive-webhook-secret.yaml
#      apiVersion: v1
#      kind: Secret
#      metadata:
#        name: gitea-webhook-secret-amactive
#        namespace: cicd
#      type: Opaque
#      stringData:
#        secretToken: "$WEBHOOK_TOKEN"
#      EOF
#
#   3. Selar com kubeseal:
#      kubeseal --controller-namespace=kube-system \
#               --controller-name=sealed-secrets-controller \
#               --format=yaml < /tmp/amactive-webhook-secret.yaml > sealedsecret-webhook.yaml
#
#      shred -u /tmp/amactive-webhook-secret.yaml
#
#   4. No Gitea, repositório labadmin/amactive → Settings → Webhooks →
#      Add Webhook → Gitea:
#        - Target URL: endpoint exposto do EventListener (ver infra/README.md)
#        - Secret: o mesmo $WEBHOOK_TOKEN gerado no passo 1
#        - Trigger On: Push Events / Branch filter: main
#
#   5. Commitar APENAS o sealedsecret-webhook.yaml selado (renomear este
#      arquivo, sem o sufixo .example).
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: gitea-webhook-secret-amactive
  namespace: cicd
spec:
  encryptedData:
    secretToken: PLACEHOLDER_SUBSTITUIR_POR_VALOR_SELADO
  template:
    metadata:
      name: gitea-webhook-secret-amactive
      namespace: cicd
      labels:
        app.kubernetes.io/component: "ci-secret"
        app.kubernetes.io/managed-by: "argocd"
        app.kubernetes.io/name: "amactive-tekton"
        app.kubernetes.io/part-of: "amactive"
        environment: "dev"
        lab_id: "lab-k8s-01"
        lab_owner: "jose.mussauer"
    type: Opaque

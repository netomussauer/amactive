# ATENÇÃO: este arquivo é apenas um TEMPLATE. Não commitar valores reais.
#
# Como gerar o SealedSecret correto (após ter acesso real ao cluster, com
# SealedSecrets já instalado no ns cicd):
#
#   1. Pegar/definir a senha do usuário Postgres `amactive` (criada junto com
#      o banco — ver infra/README.md, passo "Provisionar o banco no Postgres
#      compartilhado"). Se já provisionado:
#      kubectl -n shared-infra get secret postgresql-secret \
#        -o jsonpath='{.data.AMACTIVE_PASSWORD}' | base64 -d
#
#   2. Gerar um JWT_SECRET forte (nunca reaproveitar o default
#      "change-me-in-env" de apps/api/.env.example — settings.py rejeita
#      esse valor fora de ENVIRONMENT=development):
#      openssl rand -base64 48
#
#   3. Criar o Secret em manifest local (NÃO commitar):
#      cat <<EOF > /tmp/amactive-secrets.yaml
#      apiVersion: v1
#      kind: Secret
#      metadata:
#        name: amactive-secrets
#        namespace: amactive
#      type: Opaque
#      stringData:
#        pg-password: "<senha-do-pg-aqui>"
#        jwt-secret:  "<jwt-secret-aqui>"
#      EOF
#
#   4. Selar com kubeseal (chave pública do controller deste cluster):
#      kubeseal --controller-namespace=cicd \
#               --controller-name=sealed-secrets \
#               --format=yaml < /tmp/amactive-secrets.yaml > sealedsecret.yaml
#
#   5. Apagar o Secret em texto puro:
#      shred -u /tmp/amactive-secrets.yaml
#
#   6. Commitar APENAS o sealedsecret.yaml selado (renomear este arquivo,
#      sem o sufixo .example, e remover ele do exclude do ArgoCD Application
#      — ver infra/argocd/application.yaml `directory.exclude: "*.example"`).
#
# O SealedSecret abaixo é só placeholder — substituir antes de aplicar.
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: amactive-secrets
  namespace: amactive
spec:
  encryptedData:
    pg-password: PLACEHOLDER_SUBSTITUIR_POR_VALOR_SELADO
    jwt-secret:  PLACEHOLDER_SUBSTITUIR_POR_VALOR_SELADO
  template:
    metadata:
      name: amactive-secrets
      namespace: amactive
      labels:
        app.kubernetes.io/name: "amactive"
        app.kubernetes.io/component: "config"
        app.kubernetes.io/managed-by: "argocd"
        environment: "dev"
        lab_id: "lab-k8s-01"
        lab_owner: "jose.mussauer"
    type: Opaque

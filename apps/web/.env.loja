# Build da vitrine online (npm run build:loja). Nada aqui é segredo: o conteúdo
# vai para o bundle público da loja.
#
# Seleciona a aplicação da vitrine em src/main.tsx (sem as telas administrativas).
VITE_APP=loja
# Mesma origem: o nginx da vitrine repassa /api/ à API (sem CORS).
VITE_API_URL=/api
# Número do WhatsApp que recebe os pedidos, só dígitos com DDI (55 + DDD + número).
# Número comercial da loja (não é segredo): (21) 96546-0985.
VITE_WHATSAPP_LOJA=5521965460985

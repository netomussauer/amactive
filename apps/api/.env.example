APP_NAME=AMACTIVE API
ENVIRONMENT=development

# Usado quando a API roda FORA do Docker (ex.: `uvicorn` local apontando
# para o Postgres do `docker compose up db`, hostname `localhost`). Ao rodar
# via `docker compose up`, o serviço `api` sobrescreve esta variável
# automaticamente com o hostname `db` (ver `environment:` em
# docker-compose.yml) — não é necessário editar esta linha para o fluxo de
# Docker Compose funcionar.
DATABASE_URL=postgresql+asyncpg://amactive:amactive@localhost:5432/amactive

# Diretório onde as imagens de produto são gravadas em disco (relativo ao
# diretório de trabalho do processo uvicorn quando a API roda fora do
# Docker). Ao rodar via `docker compose up`, o serviço `api` sobrescreve
# esta variável automaticamente para `/app/uploads` (ver `environment:` em
# docker-compose.yml), onde fica montado o volume `amactive_uploads_data`.
UPLOADS_DIR=./uploads

# Origens liberadas para CORS, separadas por vírgula. O default já cobre o
# Vite dev server local (apps/web, porta 5173) — só precisa mudar se o
# frontend rodar em outra porta/host.
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Chave simétrica de pgp_sym_encrypt/pgp_sym_decrypt (pgcrypto) usada para
# cifrar/decifrar o token/secret do app privado da Nuvemshop em
# credencial_canal — ver docs/design-integracao-nuvemshop.md §7.2. Mesmo
# padrão de JWT_SECRET: troque por um valor forte fora de desenvolvimento
# (ENVIRONMENT != development), nunca reaproveite este default.
CREDENCIAL_CANAL_ENCRYPTION_KEY=change-me-in-env
